#cloud-config

package_update: true
package_upgrade: false

packages:
  - curl
  - wget
  - iptables
  - iproute2
  - wireguard-tools
  - jq
  - htop
  - ca-certificates

write_files:
  - path: /usr/local/bin/bootstrap-cluster.sh
    permissions: '0755'
    content: |
      #!/usr/bin/env bash
      set -euo pipefail
      exec > >(tee -a /var/log/bootstrap-cluster.log) 2>&1

      echo "=== [1/4] Aktiviere 4GB SSD-Swapfile ==="
      if [ ! -f /swapfile ]; then
        fallocate -l 4G /swapfile || dd if=/dev/zero of=/swapfile bs=1M count=4096
        chmod 600 /swapfile
        mkswap /swapfile
        swapon /swapfile
        echo "/swapfile none swap sw 0 0" >> /etc/fstab
      fi

      echo "=== [2/4] Ermittle EC2 Metadaten ==="
      TOKEN_IMDS=$(curl -s -X PUT "http://169.254.169.254/latest/api/token" -H "X-aws-ec2-metadata-token-ttl-seconds: 60" || true)
      PUBLIC_IPV4=$(curl -s -H "X-aws-ec2-metadata-token: $TOKEN_IMDS" http://169.254.169.254/latest/meta-data/public-ipv4 || true)
      PRIVATE_IPV4=$(curl -s -H "X-aws-ec2-metadata-token: $TOKEN_IMDS" http://169.254.169.254/latest/meta-data/local-ipv4 || true)

      echo "Rolle:        ${node_role}"
      echo "Node Name:    ${node_name}"
      echo "Public IP:    $${PUBLIC_IPV4:-127.0.0.1}"
      echo "Private IP:   $${PRIVATE_IPV4:-127.0.0.1}"

      if [ "${node_role}" = "server" ]; then
        echo "=== [3/4] Starte K3s Server Bootstrap: $(date) ==="
        curl -sfL https://get.k3s.io | INSTALL_K3S_EXEC="server \
          --token ${k3s_token} \
          --node-name ${node_name} \
          --tls-san $${PUBLIC_IPV4:-127.0.0.1} \
          --tls-san $${PRIVATE_IPV4:-127.0.0.1} \
          --node-ip $${PRIVATE_IPV4:-127.0.0.1} \
          --node-external-ip $${PUBLIC_IPV4:-127.0.0.1} \
          --flannel-backend=wireguard-native \
          --flannel-external-ip \
          --write-kubeconfig-mode 644 \
          --kubelet-arg fail-swap-on=false" sh -

        export KUBECONFIG=/etc/rancher/k3s/k3s.yaml

        echo "=== [4/4] Richte Kubeconfig fuer ubuntu User ein ==="
        mkdir -p /home/ubuntu/.kube
        cp /etc/rancher/k3s/k3s.yaml /home/ubuntu/.kube/config
        chown -R ubuntu:ubuntu /home/ubuntu/.kube
        echo "export KUBECONFIG=/etc/rancher/k3s/k3s.yaml" >> /home/ubuntu/.bashrc

        echo "Warte auf K3s Ready Status..."
        until kubectl get nodes | grep -q " Ready"; do
          sleep 3
        done

        echo "=== K3s Server (${node_name}) erfolgreich gebootstrappt: $(date) ===" > /var/log/bootstrap-complete.log
      else
        echo "=== [3/4] Starte K3s Agent (Worker) Bootstrap: $(date) ==="
        curl -sfL https://get.k3s.io | K3S_URL="${server_url}" K3S_TOKEN="${k3s_token}" INSTALL_K3S_EXEC="agent \
          --node-name ${node_name} \
          --node-ip $${PRIVATE_IPV4:-127.0.0.1} \
          --node-external-ip $${PUBLIC_IPV4:-127.0.0.1} \
          --kubelet-arg fail-swap-on=false" sh -

        echo "=== [4/4] K3s Agent (${node_name}) erfolgreich gestartet und verbunden: $(date) ===" > /var/log/bootstrap-complete.log
      fi

runcmd:
  - /usr/local/bin/bootstrap-cluster.sh
